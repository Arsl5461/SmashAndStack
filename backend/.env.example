NODE_ENV=development
PORT=5001
APP_NAME=Smash & Stack API
APP_URL=http://localhost:5001
CLIENT_URL=http://localhost:5174

MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/smash_and_stack

JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SUPER_ADMIN_NAME=Smash & Stack Owner
SUPER_ADMIN_EMAIL=admin@smashandstack.com
SUPER_ADMIN_PASSWORD=SmashStack!123

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DRIVER=local

SEED_DEMO_DATA=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
